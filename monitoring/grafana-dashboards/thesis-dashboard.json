{
  "title": "Thesis — Autoscaling",
  "uid": "thesis-autoscaling",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Ready nodes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "legendFormat": "ready nodes (control plane + workers)"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pending pods (the autoscaler's trigger signal)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{phase=\"Pending\"})",
          "legendFormat": "pending pods"
        }
      ]
    },
    {
      "id": 3,
      "title": "CPU utilisation per node",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Workload pod network I/O (JMeter-driven traffic proxy)",
      "description": "No JMeter->Prometheus backend listener is wired up in this setup, so true client-observed request rate/latency is not available here — see results/jmeter-*.jtl for that. This panel uses container network throughput on the workload pods as an in-cluster proxy for traffic volume/continuity during a scale-up.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"default\"}[1m])) by (pod)",
          "legendFormat": "{{pod}} rx bytes/s"
        }
      ]
    }
  ]
}
