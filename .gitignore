# ===========================================================================
# .gitignore
# ===========================================================================
# CRITICAL: the two things that must never reach a public repository are
# OpenTofu state (contains resource IDs and sometimes secrets) and any file
# holding real credentials.
# ===========================================================================

# --- OpenTofu / Terraform state -------------------------------------------
# State is the single source of truth about what exists. Back it up
# separately; never commit it.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
crash.log

# --- Secrets ---------------------------------------------------------------
# production.tfvars holds the real API token and passwords for the Hof
# server. Commit production.tfvars.example instead.
production.tfvars
*.auto.tfvars
secrets.tfvars
*.pem
*.key
id_rsa*
kubeconfig*
.env

# opentofu/modules/k8s-control-plane extracts the K3s node-token here via SSH
# so it can be wired into the workers' join config within the same apply.
opentofu/.generated/

# Kubernetes client configs and any other tfvars (may hold tokens/passwords)
.kube/
*.tfvars
!*.tfvars.example
*.token
*.secret
*.p12
*.pfx
*.crt
*.csr
id_ed25519*
.env.*
terraform.tfstate.d/

# Third-party document, not mine to publish
Master Thesis Khen Quartey.pdf

# --- Measurement output ----------------------------------------------------
# Keep the DIRECTORY (results/.gitkeep) but not the raw runs, which are
# regenerated by experiments. Commit only the final analysed summaries you
# actually cite in the thesis.
results/*.jsonl
results/*.csv
!results/summary-*.csv

# --- JMeter run artefacts --------------------------------------------------
jmeter/*.jtl
jmeter/report/
jmeter.log

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
__pycache__/
*.pyc
