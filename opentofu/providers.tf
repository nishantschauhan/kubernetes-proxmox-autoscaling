# ============================================================================
# providers.tf — Provider configuration
# ============================================================================
# This is the ONLY file that talks to Proxmox directly. Everything else in
# this repo goes through it. On hardware day, you do not edit this file —
# you only fill in production.tfvars, because every value here is a variable.
# ============================================================================

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    proxmox = {
      source  = "bpg/proxmox"
      version = "~> 0.66"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }

  # NOTE: state is local for this thesis. That is fine for a single-operator
  # study, but it means the .tfstate file is the single source of truth about
  # what exists. Back it up. Never commit it (see .gitignore).
}

provider "proxmox" {
  # e.g. "https://192.168.1.10:8006/" — filled from tfvars, never hardcoded
  endpoint = var.proxmox_endpoint

  # API token auth (root@pam!tokenid=uuid), via TF_VAR_proxmox_api_token so it
  # never touches disk. LXC containers here need privileged features (nesting,
  # keyctl, fuse) for kubelet to run — if the token lacks permission for that,
  # untick "Privilege Separation" on the token in the Proxmox UI (Datacenter ->
  # Permissions -> API Tokens), as docs/SETUP-CHECKLIST.md already instructs.
  api_token = var.proxmox_api_token

  # Proxmox ships with a self-signed certificate by default. Set to true for
  # a lab environment; document this choice in the thesis as a lab constraint.
  insecure = var.proxmox_insecure

  # The provider needs SSH to the Proxmox host for a few operations
  # (notably uploading cloud-init snippets to local storage).
  ssh {
    agent    = true
    username = var.proxmox_ssh_username
  }
}
